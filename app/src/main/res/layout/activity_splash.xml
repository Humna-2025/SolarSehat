<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pale_blue"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgSplashLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="@string/desc_logo"
        android:src="@drawable/ic_sun" />

    <TextView
        android:id="@+id/txtSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_title"
        android:textColor="@color/primary_emerald"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSplashSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/app_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <ProgressBar
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="60dp"
        android:indeterminateTint="@color/primary_emerald" />

    <TextView
        android:id="@+id/txtSplashStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/loading"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

</LinearLayout>
